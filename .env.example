DJANGO_SECRET_KEY=generate-your-own-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DB_NAME=room_booking
DB_USER=room_booking
DB_PASSWORD=replace-with-your-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
DEMO_PAYMENTS_ENABLED=true
# Optional private Telegram staff bot. See docs/TELEGRAM.md.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
DEFAULT_FROM_EMAIL='Haircut Studio <noreply@example.test>'
# For deployment, configure SMTP privately and use DJANGO_DEBUG=false.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.your-domain.example
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-private-login
# EMAIL_HOST_PASSWORD=your-private-password
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL='Haircut Studio <bookings@your-domain.example>'
# TRUSTED_PROXY_CIDRS=127.0.0.1/32
# Enable the following only when every affected subdomain supports HTTPS.
